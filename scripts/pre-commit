#!/bin/bash

NEEDS_FORMAT=0

# --- C/C++ (clang-format) ---------------------------------------------------

CLANG_FORMAT=$(which clang-format 2>/dev/null)
C_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp)$')

if [ -n "$C_FILES" ]; then
    if [ -z "$CLANG_FORMAT" ]; then
        echo "warning: clang-format not found — skipping C/C++ format check"
    else
        for FILE in $C_FILES; do
            if ! "$CLANG_FORMAT" --dry-run --Werror "$FILE" 2>/dev/null; then
                echo "  needs formatting: $FILE"
                NEEDS_FORMAT=1
            fi
        done
    fi
fi

# --- QML (qmlformat) --------------------------------------------------------

QMLFORMAT=$(which qmlformat 2>/dev/null)
if [ -z "$QMLFORMAT" ]; then
    # not on PATH on a default Qt install — take the newest Qt kit's binary
    QMLFORMAT=$(ls "$HOME"/Qt/*/macos/bin/qmlformat 2>/dev/null | sort -V | tail -1)
fi
QML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.qml$')

if [ -n "$QML_FILES" ]; then
    if [ -z "$QMLFORMAT" ]; then
        echo "warning: qmlformat not found — skipping QML format check"
    else
        for FILE in $QML_FILES; do
            if ! "$QMLFORMAT" "$FILE" 2>/dev/null | cmp -s - "$FILE"; then
                echo "  needs formatting: $FILE"
                NEEDS_FORMAT=1
            fi
        done
    fi
fi

if [ "$NEEDS_FORMAT" -ne 0 ]; then
    echo ""
    echo "Run: cmake --build build --target format"
    exit 1
fi

exit 0
